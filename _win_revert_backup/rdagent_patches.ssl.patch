+# ---------------------------------------------------------------------------
+# Patch 0 – SSL 上下文（必须在所有 import 之前执行）
+# ---------------------------------------------------------------------------
+
+def _patch_ssl_default_context() -> None:
+    """Windows 上 ssl.create_default_context() 加载系统证书存储时崩溃。
+
+    某些 Windows 系统证书的 ASN.1 编码被 Python/OpenSSL 误读，导致：
+        ssl.SSLError: [ASN1: NOT_ENOUGH_DATA] not enough data
+
+    aiohttp（litellm 的依赖）在导入时就调用 ssl.create_default_context()，
+    所以必须在 import rdagent 之前修补此函数。
+
+    修补后使用 certifi 证书包替代 Windows 系统证书存储。
+    """
+    try:
+        import certifi
+
+        _cert_path = certifi.where()
+        os.environ.setdefault("SSL_CERT_FILE", _cert_path)
+        os.environ.setdefault("REQUESTS_CA_BUNDLE", _cert_path)
+
+        _orig = ssl.create_default_context
+
+        def _patched(purpose: object = ssl.Purpose.SERVER_AUTH,
+                     cafile: str | None = None, capath: str | None = None,
+                     cadata: object = None) -> ssl.SSLContext:
+            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+            ctx.minimum_version = ssl.TLSVersion.TLSv1_2
+            ctx.load_verify_locations(
+                cafile=cafile or _cert_path, capath=capath, cadata=cadata
+            )
+            return ctx
+
+        ssl.create_default_context = _patched  # type: ignore[assignment]
+    except ImportError:
+        pass
+
+
+# 立即执行 SSL 补丁（在模块加载时，确保后续 import 安全）
+if sys.platform == "win32":
+    _patch_ssl_default_context()
+
 
 def apply() -> None:
     """Apply all Windows patches to rdagent.  Safe to call multiple times."""
